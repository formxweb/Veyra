---
import { collectionStats, representatives, views } from '../../data/catalog';
import { formatPrice } from '../../lib/format';
import Icon from '../ui/Icon.astro';
import Mosaic from '../product/Mosaic.astro';

const cols = await Promise.all(
  collectionStats().map(async (c) => ({ ...c, reps: await views(representatives(c.id, 4)) })),
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="koleksiyonlar" class="section cols" aria-labelledby="cols-title">
  <div class="container cols__head" data-reveal>
    <p class="eyebrow eyebrow--rule">Koleksiyonlar</p>
    <h2 id="cols-title" class="cols__title">
      {cols.length} koleksiyon, <em>tek bir özen.</em>
    </h2>
    <p class="lede">Ürünleri kullanım alanına göre grupladık. Bir koleksiyona dokunun; içindeki tüm ürünleri fiyatlarıyla görün.</p>
  </div>

  <!-- Desktop: index list with a sticky stage that previews each collection's products -->
  <div class="container cols__body">
    <div class="cols__stage" aria-hidden="true">
      {
        cols.map((c, i) => (
          <div class:list={['cols__stage-set', { 'is-active': i === 0 }]} data-stage={i}>
            <Mosaic items={c.reps} sizes="(min-width: 64em) 16vw, 1px" />
          </div>
        ))
      }
      <span class="cols__stage-cap" data-stage-cap>{cols[0]?.kicker}</span>
    </div>
    <ol class="cols__list" role="list">
      {
        cols.map((c, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <a href={`/koleksiyon/${c.slug}`} class="cols__item" data-index={i} data-kicker={c.kicker}>
              <span class="cols__num">{pad(i + 1)}</span>
              <span class="cols__main">
                <span class="cols__name">{c.title}</span>
                <span class="cols__brands">{c.kicker}</span>
              </span>
              <span class="cols__meta">
                <span class="num">{c.count} ürün</span>
                {c.from != null && <span class="num">{formatPrice(c.from)}’den</span>}
              </span>
              <Icon name="arrow-right" class="icon cols__arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Mobile & tablet: swipeable collection cards with real products -->
  <ul class="rail cols__rail" role="list" aria-label="Koleksiyonlar">
    {
      cols.map((c, i) => (
        <li>
          <a href={`/koleksiyon/${c.slug}`} class="cols__card">
            <Mosaic items={c.reps} sizes="(max-width: 63.99em) 34vw, 1px" />
            <span class="cols__card-text">
              <span class="cols__num">{pad(i + 1)}</span>
              <span class="cols__card-name">{c.title}</span>
              <span class="cols__card-meta num">
                {c.count} ürün{c.from != null ? ` · ${formatPrice(c.from)}’den` : ''}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const items = document.querySelectorAll<HTMLAnchorElement>('.cols__item');
  const stage = document.querySelectorAll<HTMLElement>('[data-stage]');
  const cap = document.querySelector<HTMLElement>('[data-stage-cap]');
  const activate = (i: number, kicker?: string) => {
    stage.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.stage) === i));
    items.forEach((a) => a.classList.toggle('is-active', Number(a.dataset.index) === i));
    if (cap && kicker) cap.textContent = kicker;
  };
  items.forEach((a) => {
    const go = () => activate(Number(a.dataset.index), a.dataset.kicker);
    a.addEventListener('mouseenter', go);
    a.addEventListener('focus', go);
  });
  if (items[0]) items[0].classList.add('is-active');
</script>

<style>
  .cols__head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
  }

  .cols__title {
    font-size: var(--fs-1);
    max-width: 14ch;
  }

  .cols__body {
    display: none;
  }

  .cols__rail {
    grid-auto-columns: min(72%, 20rem);
    margin: 0;
    list-style: none;
  }

  @media (min-width: 64em) {
    .cols__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }

    .cols__head .eyebrow {
      grid-column: 1 / -1;
    }

    .cols__head .lede {
      justify-self: end;
    }

    .cols__body {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
      align-items: start;
    }

    .cols__rail {
      display: none;
    }
  }

  .cols__stage {
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
    aspect-ratio: 4 / 5;
    background: var(--stone-100);
    overflow: hidden;
  }

  .cols__stage-set {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity var(--dur-3) var(--ease-out),
      transform var(--dur-4) var(--ease-out);
  }

  .cols__stage-set.is-active {
    opacity: 1;
    transform: none;
  }

  .cols__stage-cap {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    padding: 0.45rem 0.75rem;
    background: rgb(250 247 241 / 0.92);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cols__list {
    border-top: 1px solid var(--line);
  }

  .cols__item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto 2rem;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  .cols__num {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    color: var(--muted);
    font-variant-numeric: lining-nums;
  }

  .cols__main {
    display: grid;
    gap: 0.35rem;
  }

  .cols__name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.2rem + 1.5vw, 2.9rem);
    font-weight: 320;
    line-height: 1.05;
    letter-spacing: -0.02em;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .cols__brands {
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .cols__meta {
    display: grid;
    justify-items: end;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .cols__arrow {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--dur-2),
      transform var(--dur-3) var(--ease-out);
  }

  .cols__item.is-active .cols__name {
    transform: translateX(0.5rem);
    font-style: italic;
  }

  .cols__item.is-active .cols__arrow {
    opacity: 1;
    transform: none;
  }

  .cols__item::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-4) var(--ease-out);
  }

  .cols__item.is-active::before {
    transform: scaleX(1);
  }

  .cols__card {
    display: grid;
    gap: var(--s-3);
  }

  .cols__card-text {
    display: grid;
    gap: 0.15rem;
  }

  .cols__card-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 350;
    line-height: 1.1;
  }

  .cols__card-meta {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
</style>
