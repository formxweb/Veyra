---
import { brand } from '../../config/site';
import { catalogMeta, featured, views } from '../../data/catalog';
import { formatPrice } from '../../lib/format';
import { waLink } from '../../lib/whatsapp';
import Icon from '../ui/Icon.astro';

const items = await views(featured(6));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow eyebrow--rule hero__eyebrow">VEYRA TİCARET · {brand.location.label.toLocaleUpperCase('tr-TR')}</p>
      <h1 id="hero-title" class="display hero__title">
        <span class="hero__line"><span>Özenle seçilir.</span></span>
        <span class="hero__line"><span><em>Güvenle</em> ulaşır.</span></span>
      </h1>
      <p class="lede hero__lede">
        Dyson’dan Philips’e, retro mutfak klasiklerinden termoslara ve saatlere: {catalogMeta.total} ürünlük seçki. WhatsApp
        üzerinden kişisel sipariş, Türkiye’nin 81 iline kargo.
      </p>
      <div class="hero__ctas">
        <a class="btn" href="/magaza">Ürünleri İncele <Icon name="arrow-right" class="icon icon--arrow" /></a>
        <a class="link" href={waLink('Merhaba VEYRA, ürünleriniz hakkında bilgi almak istiyorum.')} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> WhatsApp’tan yazın
        </a>
      </div>
      <dl class="hero__facts">
        <div><dt>Ürün</dt><dd class="num">{catalogMeta.total}</dd></div>
        <div><dt>Koleksiyon</dt><dd class="num">{catalogMeta.collections}</dd></div>
        <div><dt>İle kargo</dt><dd class="num">{brand.shipping.coverage}</dd></div>
        <div><dt>Ödeme</dt><dd>{brand.payment.label}</dd></div>
      </dl>
    </div>

    <div class="hero__wall">
      <p class="hero__wall-label">Vitrinden</p>
      <ul role="list" class="hero__tiles">
        {
          items.map((p, i) => (
            <li class="hero__tile" style={`--i:${i}`} data-cat={p.category}>
              <a href={p.href}>
                <span class="hero__mat">
                  {p.image && (
                    <span class="pcard__print" style={`--ar:${p.image.width} / ${p.image.height}`}>
                      <img
                        src={p.image.src}
                        srcset={p.image.srcset}
                        sizes="(min-width: 64em) 12vw, 40vw"
                        width={p.image.width}
                        height={p.image.height}
                        alt={p.name}
                        loading={i < 3 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                        decoding="async"
                      />
                    </span>
                  )}
                </span>
                <span class="hero__cap">
                  <span class="hero__cap-name">{p.name}</span>
                  <span class="price">{formatPrice(p.price)}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background:
      radial-gradient(70% 90% at 82% 8%, rgb(255 251 244 / 0.9), transparent 62%),
      linear-gradient(180deg, #f1ebe1 0%, #e8dfd1 100%);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: var(--s-7);
    padding-block: var(--s-7) var(--s-8);
    min-height: clamp(36rem, calc(100svh - var(--bar-h) - var(--header-h)), 54rem);
    align-items: center;
  }

  @media (min-width: 64em) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--s-8);
    }
  }

  .hero__text {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .hero__title {
    font-size: clamp(3rem, 1.6rem + 4.6vw, 6.5rem);
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__line > span {
    display: block;
    animation: line-up 1.2s var(--ease-out) both;
  }

  .hero__line:nth-child(2) > span {
    animation-delay: 0.1s;
  }

  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  .hero__eyebrow,
  .hero__lede,
  .hero__ctas,
  .hero__facts {
    animation: fade-up 1s var(--ease-out) both;
  }

  .hero__lede {
    animation-delay: 0.3s;
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .hero__ctas {
    animation-delay: 0.42s;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }

  .hero__facts {
    animation-delay: 0.55s;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-strong);
  }

  .hero__facts div {
    display: grid;
    gap: 0.1rem;
  }

  .hero__facts dt {
    order: 2;
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__facts dd {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---- product wall ---- */
  .hero__wall {
    position: relative;
  }

  .hero__wall-label {
    margin-bottom: var(--s-3);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5) var(--s-4);
  }

  .hero__tile {
    animation: tile-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--i) * 0.08s);
  }

  @media (min-width: 64em) {
    .hero__tile:nth-child(3n + 2) {
      transform: translateY(2.5rem);
    }
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  .hero__tile a {
    display: grid;
    gap: var(--s-2);
  }

  .hero__mat {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 9%;
    background: var(--mat);
    box-shadow: inset 0 0 0 1px rgb(18 17 15 / 0.04);
    transition: background-color var(--dur-3);
  }

  .hero__mat :global(.pcard__print) {
    height: 100%;
    width: auto;
    max-width: 100%;
  }

  @media (hover: hover) {
    .hero__tile a:hover :global(.pcard__print) {
      transform: translateY(-5px);
      box-shadow: var(--shadow-print-hover);
    }
  }

  .hero__cap {
    display: grid;
    gap: 0.1rem;
    font-size: var(--fs-xs);
  }

  .hero__cap-name {
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero__cap .price {
    font-size: var(--fs-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line > span,
    .hero__eyebrow,
    .hero__lede,
    .hero__ctas,
    .hero__facts,
    .hero__tile {
      animation: none;
    }
  }

  /* ---- mobile: text first, then a swipeable product strip ---- */
  @media (max-width: 63.99em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr); /* the scrolling strip must not widen the column */
      min-height: 0;
      gap: var(--s-6);
      padding-block: var(--s-6) var(--s-6);
    }

    .hero__wall {
      margin-inline: calc(-1 * var(--gutter));
    }

    .hero__wall-label {
      padding-inline: var(--gutter);
    }

    .hero__tiles {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(40vw, 13rem);
      gap: var(--s-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .hero__tiles::-webkit-scrollbar {
      display: none;
    }

    .hero__tile {
      scroll-snap-align: start;
    }

    .hero__title {
      font-size: clamp(2.8rem, 12.5vw, 4.4rem);
    }

    .hero__facts dd {
      font-size: 1.25rem;
    }
  }
</style>
