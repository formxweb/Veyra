---
import { brand } from '../../config/site';
import { brandsWithCounts, catalogMeta } from '../../data/catalog';
import Icon from '../ui/Icon.astro';

const brands = brandsWithCounts();
const pillars = [
  {
    n: 'I',
    t: 'Kalite',
    d: 'Seçkideki ürünler yeni ve etiketli olarak listelenir. Her siparişten önce ürünün durumu size açıkça teyit edilir.',
  },
  {
    n: 'II',
    t: 'Güven',
    d: 'Sipariş, ödeme ve kargo boyunca muhatabınız doğrudan VEYRA’dır. Sorunuzu WhatsApp’tan yazdığınızda yanıt bizden gelir.',
  },
  {
    n: 'III',
    t: 'Uygun Fiyat',
    d: 'Fiyatlar sitede açıkça yazılıdır. Siparişi onaylamadan önce toplam tutarı ve kargo bilgisini net biçimde paylaşırız.',
  },
];
---

<section id="hikaye" class="story on-ink" aria-labelledby="story-title">
  <div class="container story__grid">
    <div class="story__intro">
      <p class="eyebrow eyebrow--rule" data-reveal>VEYRA Hakkında</p>
      <h2 id="story-title" class="story__title" data-reveal style="--reveal-i:1">
        Kalite, güven ve uygun fiyat — <em>aynı cümlede.</em>
      </h2>
      <p class="lede story__lede" data-reveal style="--reveal-i:2">
        {brand.legalName}, {brand.location.label}’den Türkiye’nin 81 iline ulaşan butik bir mağaza. Saç bakım teknolojilerinden
        mutfak klasiklerine, termoslardan saatlere uzanan {catalogMeta.total} ürünlük seçkimizi tek bir ilkeyle kuruyoruz: doğru
        ürünü, doğru fiyatla, güvenle ulaştırmak.
      </p>
    </div>
    <ol class="story__pillars" role="list">
      {
        pillars.map((p, i) => (
          <li data-reveal style={`--reveal-i:${i + 2}`}>
            <span class="story__n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="container story__brands" data-reveal>
    <p class="eyebrow">Seçkideki markalar</p>
    <ul role="list">
      {
        brands.map((b) => (
          <li>
            <a href={`/magaza?marka=${encodeURIComponent(b.name)}`}>
              <span class="story__brand">{b.name}</span>
              <span class="num story__count">{b.count} ürün</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/magaza">
          <span class="story__brand story__brand--all">Tümü</span>
          <span class="num story__count">
            {catalogMeta.total} ürün <Icon name="arrow-right" />
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .story {
    padding-block: var(--section);
  }

  .story__grid {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 64em) {
    .story__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--s-9);
      align-items: start;
    }
  }

  .story__intro {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .story__title {
    font-size: var(--fs-2);
    max-width: 15ch;
  }

  .story__lede {
    max-width: 46ch;
  }

  .story__pillars {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .story__pillars li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  .story__n {
    grid-row: span 2;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--champagne-soft);
    font-size: var(--fs-lg);
    line-height: 1.3;
  }

  .story__pillars h3 {
    font-size: var(--fs-4);
    font-weight: 380;
  }

  .story__pillars p {
    font-size: var(--fs-sm);
    color: var(--muted-on-ink);
    max-width: 46ch;
  }

  .story__brands {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-8);
  }

  .story__brands ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48em) {
    .story__brands ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 75em) {
    .story__brands ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .story__brands a {
    display: grid;
    gap: 0.2rem;
    padding: var(--s-5) var(--s-3) var(--s-5) 0;
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-2);
  }

  .story__brand {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.7vw, 1.9rem);
    font-weight: 330;
    line-height: 1.1;
  }

  .story__brand--all {
    font-style: italic;
  }

  .story__count {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--muted-on-ink);
  }

  .story__count :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .story__brands a:hover .story__brand {
    color: var(--champagne-soft);
  }
</style>
