---
import type { ProductView } from '../../lib/types';
import ProductRail from '../../islands/ProductRail';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  items: ProductView[];
  cta: { href: string; label: string };
  tone?: 'paper' | 'ivory';
}
const { id, eyebrow, title, lede, items, cta, tone = 'paper' } = Astro.props;
---

<section class:list={['section feat', `feat--${tone}`]} aria-labelledby={id}>
  <div class="container feat__head" data-reveal>
    <p class="eyebrow eyebrow--rule">{eyebrow}</p>
    <h2 id={id} class="feat__title" set:html={title} />
    {lede && <p class="lede">{lede}</p>}
  </div>
  <div data-reveal style="--reveal-i:1">
    <ProductRail client:visible items={items} label={eyebrow} cta={cta} />
  </div>
</section>

<style>
  .feat--paper {
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .feat--ivory + .feat--paper,
  .feat--paper + .feat--ivory {
    border-top: 0;
  }

  .feat__head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .feat__title {
    font-size: var(--fs-2);
    max-width: 18ch;
  }
</style>
