---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../islands/ProductGallery';
import ProductPurchase from '../../islands/ProductPurchase';
import ProductRail from '../../islands/ProductRail';
import Icon from '../../components/ui/Icon.astro';
import { brand } from '../../config/site';
import { collectionById } from '../../data/collections';
import { products, similar, toDetail, views } from '../../data/catalog';
import { formatPrice } from '../../lib/format';
import { productInquiry, waLink } from '../../lib/whatsapp';
import type { ImageMetadata } from 'astro';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: (typeof products)[number] };
const d = await toDetail(p);
const c = collectionById.get(p.category)!;
const related = await views(similar(p, 8));
const imgModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const ogImage = p.images[0] ? imgModules[`/src/assets/products/${p.images[0].file}`]?.default : undefined;

const site = Astro.site;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.id.toUpperCase(),
  category: c.title,
  ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
  ...(site && d.gallery[0] ? { image: d.gallery.map((g) => new URL(g.src, site).href) } : {}),
  ...(p.description ? { description: p.description } : {}),
  ...(p.price != null
    ? {
        offers: {
          '@type': 'Offer',
          price: p.price,
          priceCurrency: 'TRY',
          availability: p.availability === 'sold_out' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
          ...(p.condition?.startsWith('Yeni') ? { itemCondition: 'https://schema.org/NewCondition' } : {}),
          seller: { '@type': 'Organization', name: brand.legalName },
          ...(site ? { url: new URL(`/urun/${p.slug}`, site).href } : {}),
        },
      }
    : {}),
};
const crumbLd = site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: c.title, item: new URL(`/koleksiyon/${c.slug}`, site).href },
        { '@type': 'ListItem', position: 3, name: p.name },
      ],
    }
  : null;

const description = `${p.name}${p.brand ? ` (${p.brand})` : ''} — ${formatPrice(p.price)}. ${p.condition ?? ''} VEYRA TİCARET’ten WhatsApp ile sipariş, Türkiye’nin 81 iline kargo, EFT / Havale ile ödeme.`.replace(/\s+/g, ' ');
---

<BaseLayout title={p.name} description={description} image={ogImage} ogType="product" jsonLd={crumbLd ? [ld, crumbLd] : ld}>
  <div class="container pdp">
    <nav class="crumbs pdp__crumbs" aria-label="Konum">
      <ol role="list">
        <li><a href="/">Ana Sayfa</a></li>
        <li><a href={`/koleksiyon/${c.slug}`}>{c.title}</a></li>
        <li><span aria-current="page">{p.name}</span></li>
      </ol>
    </nav>

    <div class="pdp__grid">
      <div class="pdp__media">
        <ProductGallery client:load images={d.gallery} name={p.name} category={p.category} />
      </div>

      <div class="pdp__info">
        <p class="eyebrow">{p.brand ?? c.label}<span class="pdp__code">· {p.id.toUpperCase()}</span></p>
        <h1 class="pdp__title">{p.name}</h1>
        <p class="price pdp__price">{formatPrice(p.price)}</p>
        <ul class="pdp__status" role="list">
          <li><span class="dot" aria-hidden="true"></span> Satışta</li>
          {p.condition && <li><Icon name="check" /> {p.condition}</li>}
          <li><Icon name="truck" /> 81 ile kargo</li>
        </ul>

        <ProductPurchase client:load p={d} />

        <div class="acc pdp__acc">
          <details open>
            <summary>Ürün açıklaması <Icon name="plus" /></summary>
            <div class="acc__body">
              {
                p.description ? (
                  <p>{p.description}</p>
                ) : (
                  <>
                    <p>
                      Bu ürünün ayrıntılı açıklaması, ek fotoğrafları ve kutu içeriği için bize WhatsApp’tan yazın; size ürünün
                      güncel durumunu doğrudan paylaşalım.
                    </p>
                    <p>
                      <a class="link" href={waLink(productInquiry(p, 1))} target="_blank" rel="noopener">
                        Ürün hakkında soru sor <Icon name="arrow-up-right" />
                      </a>
                    </p>
                  </>
                )
              }
              {
                p.features.length > 0 && (
                  <ul class="pdp__features">
                    {p.features.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          </details>
          <details>
            <summary>Ürün bilgileri <Icon name="plus" /></summary>
            <div class="acc__body">
              <dl class="spec">
                {p.brand && (<><dt>Marka</dt><dd>{p.brand}</dd></>)}
                <dt>Koleksiyon</dt><dd><a href={`/koleksiyon/${c.slug}`}>{c.title}</a></dd>
                {p.condition && (<><dt>Durum</dt><dd>{p.condition}</dd></>)}
                <dt>Ürün kodu</dt><dd>{p.id.toUpperCase()}</dd>
                <dt>Fiyat</dt><dd>{formatPrice(p.price)} · kargo ücreti sipariş onayında iletilir</dd>
              </dl>
            </div>
          </details>
          <details>
            <summary>Ödeme &amp; kargo <Icon name="plus" /></summary>
            <div class="acc__body">
              <p><strong>Ödeme:</strong> {brand.payment.label}. {brand.payment.note} Sitede kart bilgisi istenmez.</p>
              <p><strong>Kargo:</strong> {brand.shipping.label}. Siparişiniz {brand.location.label}’den gönderilir; kargo ücreti ve gönderim bilgisi sipariş onayında paylaşılır.</p>
            </div>
          </details>
          <details>
            <summary>Sipariş nasıl verilir? <Icon name="plus" /></summary>
            <div class="acc__body">
              <p>Ürünü sepete ekleyin ve teslimat bilgilerinizi yazın; siparişiniz hazır bir WhatsApp mesajına dönüşür. Dilerseniz “WhatsApp ile Sipariş Ver” ile bu ürünü doğrudan da sorabilirsiniz.</p>
              <p><a class="link" href="/yardim">Sipariş &amp; kargo rehberi <Icon name="arrow-right" /></a></p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section pdp__related" aria-labelledby="rel-title">
        <div class="container pdp__related-head">
          <p class="eyebrow eyebrow--rule">Benzer ürünler</p>
          <h2 id="rel-title" class="pdp__related-title">
            {c.title} <em>seçkisinden</em>
          </h2>
        </div>
        <ProductRail client:visible items={related} label="Benzer ürünler" />
      </section>
    )
  }
</BaseLayout>

<style>
  .pdp {
    padding-top: var(--s-5);
    padding-bottom: var(--s-8);
  }

  .pdp__crumbs {
    margin-bottom: var(--s-5);
  }

  .pdp__crumbs li:last-child {
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pdp__grid {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 64em) {
    .pdp__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--s-8);
      align-items: start;
    }

    .pdp__media {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
    }
  }

  .pdp__info {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .pdp__code {
    margin-left: var(--s-2);
    color: var(--muted);
    font-weight: 500;
  }

  .pdp__title {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3.1rem);
    font-weight: 330;
    line-height: 1.08;
  }

  .pdp__price {
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
    font-weight: 350;
  }

  .pdp__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  .pdp__status li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .pdp__status :global(.icon) {
    width: 1rem;
    height: 1rem;
    color: var(--stone-600);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(61 90 69 / 0.15);
  }

  .pdp__acc {
    margin-top: var(--s-4);
  }

  .pdp__features {
    margin-top: var(--s-3);
    padding-left: 1.1rem;
  }

  .pdp__related {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .pdp__related-head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }

  .pdp__related-title {
    font-size: var(--fs-2);
  }

  @media (max-width: 63.99em) {
    .pdp {
      padding-bottom: calc(var(--s-8) + 4rem);
    }
  }
</style>
