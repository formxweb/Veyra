---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBrowser from '../../islands/CatalogBrowser';
import Icon from '../../components/ui/Icon.astro';
import { brandsWithCounts, collectionStats, inCategory, views } from '../../data/catalog';
import { formatPrice } from '../../lib/format';

export function getStaticPaths() {
  return collectionStats().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: ReturnType<typeof collectionStats>[number] };
const all = collectionStats();
const idx = all.findIndex((x) => x.id === c.id);
const next = all[(idx + 1) % all.length];
const items = await views(inCategory(c.id));
const art = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/cover-*.jpg', { eager: true });
const meta = art[`/src/assets/art/${c.art}.jpg`].default;
const cover = await getImage({ src: meta, widths: [480, 720, 960, 1200], format: 'webp', quality: 78 });
const dark = c.art === 'cover-signal' || c.art === 'cover-orbit';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.title,
  description: c.intro,
  numberOfItems: items.length,
};
---

<BaseLayout title={c.title} description={`${c.title}: ${c.intro}`} image={meta} jsonLd={ld}>
  <section class:list={['chero', { 'on-ink': dark }]} aria-labelledby="c-title">
    <div class="container chero__grid">
      <div class="chero__text">
        <nav class="crumbs" aria-label="Konum">
          <ol role="list">
            <li><a href="/">Ana Sayfa</a></li>
            <li><a href="/magaza">Mağaza</a></li>
            <li><span aria-current="page">{c.title}</span></li>
          </ol>
        </nav>
        <p class="eyebrow eyebrow--rule">{String(idx + 1).padStart(2, '0')} · Koleksiyon</p>
        <h1 id="c-title" class="display chero__title">{c.title}</h1>
        <p class="chero__kicker">{c.kicker}</p>
        <p class="lede">{c.intro}</p>
        <dl class="chero__facts">
          <div><dt>Ürün</dt><dd class="num">{c.count}</dd></div>
          {c.from != null && <div><dt>Başlangıç</dt><dd class="num">{formatPrice(c.from)}</dd></div>}
          {c.brands.length > 0 && <div><dt>Markalar</dt><dd>{c.brands.join(', ')}</dd></div>}
        </dl>
      </div>
      <figure class="chero__art">
        <img
          src={cover.src}
          srcset={cover.srcSet.attribute}
          sizes="(min-width: 64em) 38vw, 100vw"
          width={meta.width}
          height={meta.height}
          alt=""
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <div class="cbody">
    <CatalogBrowser client:load items={items} categories={[]} brands={brandsWithCounts()} lockedCategory={c.id} />
  </div>

  <a class="cnext" href={`/koleksiyon/${next.slug}`}>
    <span class="container cnext__inner">
      <span class="eyebrow">Sonraki koleksiyon</span>
      <span class="cnext__title">{next.title} <Icon name="arrow-right" /></span>
    </span>
  </a>
</BaseLayout>

<style>
  .chero {
    border-bottom: 1px solid var(--line);
  }

  .chero__grid {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-6) var(--s-7);
  }

  @media (min-width: 64em) {
    .chero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      padding-block: var(--s-7) var(--s-8);
    }
  }

  .chero__text {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .chero__title {
    font-size: var(--fs-hero);
  }

  .chero__kicker {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .chero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-7);
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .chero__facts div {
    display: grid;
    gap: 0.1rem;
  }

  .chero__facts dt {
    order: 2;
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .on-ink .chero__facts dt {
    color: var(--muted-on-ink);
  }

  .chero__facts dd {
    font-family: var(--font-display);
    font-size: var(--fs-4);
  }

  .chero__art {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--stone-100);
  }

  @media (max-width: 63.99em) {
    .chero__art {
      aspect-ratio: 5 / 4;
      order: -1;
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  .chero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
    animation: chero-in 1.6s var(--ease-out) both;
  }

  @keyframes chero-in {
    from {
      transform: scale(1.05);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chero__art img {
      animation: none;
    }
  }

  .cbody {
    padding-bottom: var(--section);
  }

  .cnext {
    display: block;
    border-top: 1px solid var(--line);
    background: var(--paper);
    transition: background-color var(--dur-3);
  }

  .cnext:hover {
    background: var(--stone-50);
  }

  .cnext__inner {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-8);
  }

  .cnext__title {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    font-weight: 320;
    letter-spacing: -0.02em;
  }

  .cnext__title :global(.icon) {
    width: 2rem;
    height: 2rem;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .cnext:hover .cnext__title :global(.icon) {
    transform: translateX(8px);
  }
</style>
